<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'CodeGuard - Intelligent SCM Impact & Regression Analysis' %></title>
    <meta name="description" content="Software Configuration Management (SCM) impact analysis, baseline tracking, and regression test selection dashboard.">
    <meta property="og:title" content="CodeGuard">
    <meta property="og:description" content="Software Configuration Management (SCM) impact analysis, baseline tracking, and regression test selection dashboard.">
    <link rel="stylesheet" href="/static/css/style.css">
    <% if (typeof extraHead !== 'undefined') { %><%- extraHead %><% } %>
</head>
<body>
    <nav class="navbar" id="appNavbar">
        <a href="/" class="nav-brand" id="navBrandLink">
            <div class="brand-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                </svg>
            </div>
            <div>
                <div class="brand-title">CodeGuard <span class="brand-version">v1.2</span></div>
                <div class="brand-subtitle">SCM Baseline • Impact Analysis • RTS</div>
            </div>
        </a>

        <!-- Mobile menu hamburger -->
        <button class="nav-toggle-btn" id="navToggleBtn" aria-label="Toggle navigation" aria-expanded="false" onclick="toggleNavMenu()">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="3" y1="6" x2="21" y2="6"></line>
                <line x1="3" y1="12" x2="21" y2="12"></line>
                <line x1="3" y1="18" x2="21" y2="18"></line>
            </svg>
        </button>

        <div class="nav-links" id="navLinksContainer">
            <a href="/" class="nav-link <%= typeof activePage !== 'undefined' && activePage === 'home' ? 'active' : '' %>" id="navLinkHome">Home</a>
            <a href="/dashboard" class="nav-link <%= typeof activePage !== 'undefined' && activePage === 'dashboard' ? 'active' : '' %>" id="navLinkDashboard">Dashboard</a>
            <a href="/dashboard#commits" class="nav-link <%= typeof activePage !== 'undefined' && activePage === 'commits' ? 'active' : '' %>" id="navLinkCommits">Commit Analysis</a>
            <a href="/dependency-map" class="nav-link <%= typeof activePage !== 'undefined' && activePage === 'dependency-map' ? 'active' : '' %>" id="navLinkDepMap">Dependency Map</a>
            <a href="/regression-tests" class="nav-link <%= typeof activePage !== 'undefined' && activePage === 'regression-tests' ? 'active' : '' %>" id="navLinkRegression">Regression Tests</a>
            <a href="/risk-analysis" class="nav-link <%= typeof activePage !== 'undefined' && activePage === 'risk-analysis' ? 'active' : '' %>" id="navLinkRisk">Risk Analysis</a>
            <a href="/reports" class="nav-link <%= typeof activePage !== 'undefined' && activePage === 'reports' ? 'active' : '' %>" id="navLinkReports">Reports</a>
            <a href="/about" class="nav-link <%= typeof activePage !== 'undefined' && activePage === 'about' ? 'active' : '' %>" id="navLinkAbout">About</a>

            <div class="nav-actions-group">
                <span class="nav-system-pill" id="navSystemPill" title="AST Dependency Engine & SCM Store Operational">
                    <span class="nav-system-dot"></span>
                    <span id="navSystemText">System Ready</span>
                </span>
                <button class="nav-action-btn" id="navQuickAnalyzeBtn" onclick="quickAnalyzeLatest()" title="Analyze most recent baseline">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <polygon points="5 3 19 12 5 21 5 3"></polygon>
                    </svg>
                    <span>Analyze Latest</span>
                </button>
            </div>
        </div>
    </nav>

    <!-- Global Toast Notifications Container -->
    <div id="toastContainer" class="toast-container" aria-live="polite" aria-atomic="true"></div>

    <main class="container">
