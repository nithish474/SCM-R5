<%- include('partials/header', { title: 'CodeGuard - Intelligent SCM Impact & Regression Analysis', activePage: 'home' }) %>

<style>
/* ==========================================================================
   CodeGuard Homepage Polish & Developer Tool Theme
   Palette: Deep Charcoal/Navy (#090d16 / #0f172a), Refined Blue (#3b82f6),
            Indigo (#6366f1), Subtle Cyan Accent (#06b6d4 / #38bdf8),
            Muted Slate (#94a3b8), Border Slate (#1e293b / #27354f)
   ========================================================================== */

.cg-home-wrapper {
  background: #090d16;
  background-image: 
    radial-gradient(circle at 50% 0%, rgba(37, 99, 235, 0.14) 0%, transparent 65%),
    radial-gradient(circle at 90% 20%, rgba(99, 102, 241, 0.08) 0%, transparent 50%),
    linear-gradient(rgba(255, 255, 255, 0.015) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255, 255, 255, 0.015) 1px, transparent 1px);
  background-size: 100% 100%, 100% 100%, 36px 36px, 36px 36px;
  color: #f1f5f9;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Inter", Helvetica, Arial, sans-serif;
  margin: -1.5rem -1rem 0 -1rem;
  padding: 1.5rem 1.5rem 3rem 1.5rem;
  min-height: 100vh;
}

@media (min-width: 1200px) {
  .cg-home-wrapper {
    margin: -1.75rem -2rem 0 -2rem;
    padding: 2rem 2.5rem 4rem 2.5rem;
  }
}

/* Typography & General Utilities */
.cg-mono {
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
}

.cg-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  padding: 0.25rem 0.65rem;
  font-size: 0.72rem;
  font-weight: 600;
  border-radius: 9999px;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.cg-badge-blue {
  background: rgba(59, 130, 246, 0.15);
  color: #60a5fa;
  border: 1px solid rgba(59, 130, 246, 0.35);
}

.cg-badge-cyan {
  background: rgba(6, 182, 212, 0.15);
  color: #38bdf8;
  border: 1px solid rgba(6, 182, 212, 0.35);
}

.cg-badge-green {
  background: rgba(16, 185, 129, 0.15);
  color: #34d399;
  border: 1px solid rgba(16, 185, 129, 0.35);
}

.cg-badge-amber {
  background: rgba(245, 158, 11, 0.15);
  color: #fbbf24;
  border: 1px solid rgba(245, 158, 11, 0.35);
}

.cg-badge-red {
  background: rgba(239, 68, 68, 0.15);
  color: #f87171;
  border: 1px solid rgba(239, 68, 68, 0.35);
}

.cg-badge-purple {
  background: rgba(168, 85, 247, 0.15);
  color: #c084fc;
  border: 1px solid rgba(168, 85, 247, 0.35);
}

/* Pulsing Live Dot */
.cg-pulse-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background-color: #10b981;
  box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7);
  animation: cgPulse 2s infinite cubic-bezier(0.4, 0, 0.6, 1);
  display: inline-block;
}

@keyframes cgPulse {
  0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
  70% { transform: scale(1); box-shadow: 0 0 0 7px rgba(16, 185, 129, 0); }
  100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
}

/* Section Containers */
.cg-section {
  margin-top: 3.5rem;
  margin-bottom: 3.5rem;
}

.cg-section-header {
  margin-bottom: 1.75rem;
  max-width: 820px;
}

.cg-eyebrow {
  font-size: 0.75rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: #38bdf8;
  display: block;
  margin-bottom: 0.4rem;
}

.cg-heading {
  font-size: 1.85rem;
  font-weight: 800;
  letter-spacing: -0.025em;
  color: #ffffff;
  line-height: 1.25;
  margin-bottom: 0.65rem;
}

.cg-subtext {
  font-size: 0.96rem;
  color: #94a3b8;
  line-height: 1.6;
}

/* ==========================================================================
   Hero Section
   ========================================================================== */
.cg-hero {
  display: grid;
  grid-template-columns: 1fr;
  gap: 2.25rem;
  align-items: center;
  padding: 1.5rem 0 2rem 0;
}

@media (min-width: 1024px) {
  .cg-hero {
    grid-template-columns: 1.15fr 0.95fr;
    gap: 3rem;
  }
}

.cg-hero-title {
  font-size: 2.6rem;
  font-weight: 900;
  letter-spacing: -0.035em;
  line-height: 1.15;
  color: #ffffff;
  margin: 1rem 0;
}

@media (min-width: 768px) {
  .cg-hero-title {
    font-size: 3.2rem;
  }
}

.cg-hero-title-accent {
  background: linear-gradient(135deg, #38bdf8 0%, #60a5fa 50%, #818cf8 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  display: inline-block;
}

.cg-hero-lead {
  font-size: 1.05rem;
  line-height: 1.65;
  color: #94a3b8;
  margin-bottom: 1.75rem;
  max-width: 580px;
}

/* Horizontal Pipeline Ribbon */
.cg-pipeline-ribbon {
  display: flex;
  align-items: center;
  gap: 0.35rem;
  background: rgba(15, 23, 42, 0.75);
  border: 1px solid #1e293b;
  border-radius: 10px;
  padding: 0.55rem 0.85rem;
  margin-bottom: 2rem;
  overflow-x: auto;
  white-space: nowrap;
}

.cg-pipe-step {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  font-size: 0.72rem;
  font-weight: 600;
  color: #64748b;
  padding: 0.25rem 0.45rem;
  border-radius: 6px;
  transition: all 0.2s ease;
}

.cg-pipe-step span {
  font-family: ui-monospace, monospace;
  font-size: 0.65rem;
  color: #475569;
}

.cg-pipe-step.active {
  color: #38bdf8;
  background: rgba(56, 189, 248, 0.1);
}

.cg-pipe-step.active span {
  color: #0284c7;
}

.cg-pipe-sep {
  color: #334155;
  font-size: 0.75rem;
}

/* Action Buttons */
.cg-btn-group {
  display: flex;
  gap: 0.75rem;
  flex-wrap: wrap;
}

.cg-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  font-size: 0.88rem;
  font-weight: 600;
  padding: 0.65rem 1.25rem;
  border-radius: 8px;
  text-decoration: none;
  cursor: pointer;
  transition: all 0.2s ease;
  border: 1px solid transparent;
}

.cg-btn-primary {
  background: linear-gradient(135deg, #2563eb, #1d4ed8);
  color: #ffffff;
  border-color: #3b82f6;
  box-shadow: 0 4px 14px rgba(37, 99, 235, 0.35);
}

.cg-btn-primary:hover {
  background: linear-gradient(135deg, #1d4ed8, #1e40af);
  box-shadow: 0 6px 18px rgba(37, 99, 235, 0.5);
  transform: translateY(-1px);
  color: #ffffff;
}

.cg-btn-secondary {
  background: #1e293b;
  color: #e2e8f0;
  border-color: #334155;
}

.cg-btn-secondary:hover {
  background: #27354f;
  color: #ffffff;
  border-color: #475569;
  transform: translateY(-1px);
}

.cg-btn-outline {
  background: transparent;
  color: #94a3b8;
  border-color: #334155;
}

.cg-btn-outline:hover {
  background: rgba(255, 255, 255, 0.05);
  color: #f1f5f9;
  border-color: #64748b;
  transform: translateY(-1px);
}

.cg-btn-cyan {
  background: rgba(6, 182, 212, 0.15);
  color: #38bdf8;
  border-color: rgba(6, 182, 212, 0.4);
}

.cg-btn-cyan:hover {
  background: rgba(6, 182, 212, 0.25);
  color: #ffffff;
  border-color: #06b6d4;
  transform: translateY(-1px);
}

.cg-btn-sm {
  padding: 0.45rem 0.85rem;
  font-size: 0.78rem;
}

/* Engine Console Panel (Hero Right) */
.cg-engine-panel {
  background: #0d1527;
  border: 1px solid #1e293b;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.65), 0 0 0 1px rgba(255, 255, 255, 0.03);
}

.cg-engine-header {
  background: #090f1d;
  padding: 0.75rem 1rem;
  border-bottom: 1px solid #1e293b;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.cg-terminal-dots {
  display: flex;
  gap: 0.35rem;
}

.cg-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
}

.cg-dot-red { background: #ef4444; }
.cg-dot-amber { background: #f59e0b; }
.cg-dot-green { background: #10b981; }

.cg-engine-title {
  font-family: ui-monospace, monospace;
  font-size: 0.74rem;
  color: #94a3b8;
  letter-spacing: 0.05em;
  font-weight: 600;
}

.cg-engine-body {
  padding: 1.25rem;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.cg-graph-node {
  background: rgba(15, 23, 42, 0.8);
  border: 1px solid #1e293b;
  border-radius: 8px;
  padding: 0.75rem;
  transition: all 0.2s ease;
}

.cg-graph-node:hover {
  border-color: #3b82f6;
  background: rgba(30, 41, 59, 0.7);
}

.cg-node-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 0.35rem;
}

.cg-node-tag {
  font-size: 0.7rem;
  font-weight: 700;
  text-transform: uppercase;
  color: #60a5fa;
  letter-spacing: 0.05em;
}

.cg-node-badge {
  font-family: ui-monospace, monospace;
  font-size: 0.68rem;
  color: #94a3b8;
  background: #1e293b;
  padding: 0.15rem 0.45rem;
  border-radius: 4px;
}

.cg-node-title {
  font-size: 0.84rem;
  font-weight: 700;
  color: #f1f5f9;
  display: flex;
  align-items: center;
  gap: 0.4rem;
}

.cg-node-detail {
  font-size: 0.74rem;
  color: #94a3b8;
  margin-top: 0.25rem;
  line-height: 1.4;
}

.cg-connector {
  display: flex;
  justify-content: center;
  height: 12px;
  position: relative;
}

.cg-connector-line {
  width: 2px;
  height: 100%;
  background: #334155;
}

.cg-fanout-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 0.5rem;
}

.cg-fanout-item {
  background: #0f172a;
  border: 1px solid #1e293b;
  border-radius: 6px;
  padding: 0.5rem;
  text-align: center;
}

.cg-fanout-name {
  font-family: ui-monospace, monospace;
  font-size: 0.72rem;
  font-weight: 700;
  color: #e2e8f0;
}

.cg-fanout-type {
  font-size: 0.65rem;
  color: #64748b;
  margin-top: 0.15rem;
}

.cg-risk-indicator {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(245, 158, 11, 0.1);
  border: 1px solid rgba(245, 158, 11, 0.3);
  border-radius: 8px;
  padding: 0.75rem 1rem;
}

.cg-risk-indicator.high {
  background: rgba(239, 68, 68, 0.1);
  border-color: rgba(239, 68, 68, 0.3);
}

.cg-risk-val {
  font-family: ui-monospace, monospace;
  font-weight: 800;
  font-size: 0.88rem;
  color: #f87171;
}

/* ==========================================================================
   Live System Status Bar
   ========================================================================== */
.cg-status-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #0d1527;
  border: 1px solid #1e293b;
  border-radius: 10px;
  padding: 0.65rem 1.25rem;
  margin: 1.5rem 0 3rem 0;
  flex-wrap: wrap;
  gap: 0.75rem;
}

.cg-status-online {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.06em;
  color: #10b981;
  font-family: ui-monospace, monospace;
}

.cg-status-items {
  display: flex;
  align-items: center;
  gap: 1.25rem;
  flex-wrap: wrap;
}

.cg-status-pill {
  display: flex;
  align-items: center;
  gap: 0.4rem;
  font-size: 0.74rem;
  color: #94a3b8;
}

.cg-status-pill .dot {
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: #3b82f6;
}

.cg-status-pill strong {
  color: #e2e8f0;
}

/* ==========================================================================
   FILE SELECTION & STAGING SECTION ("Analyze Your Code - Start with Your Files")
   ========================================================================== */
.cg-file-section {
  background: #0d1527;
  border: 1px solid #1e293b;
  border-radius: 14px;
  padding: 1.75rem;
  box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.5);
  margin-top: 2rem;
  margin-bottom: 3.5rem;
}

.cg-dropzone {
  border: 2px dashed #27354f;
  background: rgba(15, 23, 42, 0.6);
  border-radius: 12px;
  padding: 2.5rem 1.5rem;
  text-align: center;
  transition: all 0.25s ease;
  cursor: pointer;
  position: relative;
  outline: none;
}

.cg-dropzone:hover,
.cg-dropzone:focus-visible {
  border-color: #38bdf8;
  background: rgba(56, 189, 248, 0.04);
}

.cg-dropzone.drag-active {
  border-color: #38bdf8;
  background: rgba(56, 189, 248, 0.08);
  box-shadow: 0 0 25px rgba(56, 189, 248, 0.2);
  transform: scale(1.005);
}

.cg-dropzone-icon {
  width: 54px;
  height: 54px;
  border-radius: 12px;
  background: rgba(56, 189, 248, 0.12);
  border: 1px solid rgba(56, 189, 248, 0.3);
  color: #38bdf8;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 1rem;
}

.cg-dropzone-title {
  font-size: 1.15rem;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 0.35rem;
}

.cg-dropzone-subtitle {
  font-size: 0.86rem;
  color: #94a3b8;
  margin-bottom: 1.25rem;
  max-width: 520px;
  margin-left: auto;
  margin-right: auto;
}

.cg-file-types-strip {
  display: flex;
  justify-content: center;
  gap: 0.45rem;
  flex-wrap: wrap;
  margin-top: 1.25rem;
}

.cg-file-pill {
  font-family: ui-monospace, monospace;
  font-size: 0.7rem;
  color: #64748b;
  background: #111827;
  border: 1px solid #1f2937;
  padding: 0.2rem 0.55rem;
  border-radius: 6px;
}

/* Alert Notification Banner */
.cg-alert {
  padding: 0.75rem 1rem;
  border-radius: 8px;
  font-size: 0.82rem;
  margin-top: 1rem;
  display: none;
  align-items: flex-start;
  gap: 0.6rem;
  line-height: 1.45;
}

.cg-alert-error {
  background: rgba(239, 68, 68, 0.12);
  border: 1px solid rgba(239, 68, 68, 0.35);
  color: #fca5a5;
}

.cg-alert-warning {
  background: rgba(245, 158, 11, 0.12);
  border: 1px solid rgba(245, 158, 11, 0.35);
  color: #fde047;
}

.cg-alert-success {
  background: rgba(16, 185, 129, 0.12);
  border: 1px solid rgba(16, 185, 129, 0.35);
  color: #86efac;
}

.cg-alert-info {
  background: rgba(56, 189, 248, 0.12);
  border: 1px solid rgba(56, 189, 248, 0.35);
  color: #bae6fd;
}

/* Staged Queue Header & Action Bar */
.cg-queue-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 1.5rem;
  padding-bottom: 0.85rem;
  border-bottom: 1px solid #1e293b;
  flex-wrap: wrap;
  gap: 0.75rem;
}

.cg-queue-count {
  font-size: 0.92rem;
  font-weight: 700;
  color: #f1f5f9;
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.cg-queue-actions {
  display: flex;
  gap: 0.6rem;
  align-items: center;
}

/* Queue File List Table / Grid */
.cg-file-list {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  margin-top: 0.85rem;
  max-height: 380px;
  overflow-y: auto;
  padding-right: 0.25rem;
}

.cg-file-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #111827;
  border: 1px solid #1e293b;
  border-radius: 8px;
  padding: 0.65rem 0.85rem;
  transition: all 0.2s ease;
}

.cg-file-row:hover {
  border-color: #334155;
  background: #162035;
}

.cg-file-info {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  min-width: 0;
  flex: 1;
}

.cg-file-ext-icon {
  font-family: ui-monospace, monospace;
  font-size: 0.68rem;
  font-weight: 700;
  padding: 0.25rem 0.5rem;
  border-radius: 5px;
  min-width: 44px;
  text-align: center;
  text-transform: uppercase;
}

.cg-ext-py { background: rgba(56, 189, 248, 0.15); color: #38bdf8; border: 1px solid rgba(56, 189, 248, 0.3); }
.cg-ext-ts, .cg-ext-js { background: rgba(234, 179, 8, 0.15); color: #facc15; border: 1px solid rgba(234, 179, 8, 0.3); }
.cg-ext-json, .cg-ext-yaml, .cg-ext-yml { background: rgba(249, 115, 22, 0.15); color: #fb923c; border: 1px solid rgba(249, 115, 22, 0.3); }
.cg-ext-sql { background: rgba(168, 85, 247, 0.15); color: #c084fc; border: 1px solid rgba(168, 85, 247, 0.3); }
.cg-ext-test { background: rgba(16, 185, 129, 0.15); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.3); }
.cg-ext-default { background: #1e293b; color: #94a3b8; border: 1px solid #334155; }

.cg-file-name-meta {
  min-width: 0;
  flex: 1;
}

.cg-file-name {
  font-family: ui-monospace, monospace;
  font-size: 0.82rem;
  font-weight: 600;
  color: #f1f5f9;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.cg-file-meta {
  font-size: 0.7rem;
  color: #64748b;
  display: flex;
  gap: 0.6rem;
  margin-top: 0.15rem;
}

.cg-file-btn-remove {
  background: transparent;
  border: none;
  color: #64748b;
  padding: 0.35rem;
  border-radius: 6px;
  cursor: pointer;
  transition: all 0.2s ease;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cg-file-btn-remove:hover {
  background: rgba(239, 68, 68, 0.15);
  color: #ef4444;
}

/* Empty Queue Placeholder */
.cg-queue-empty {
  text-align: center;
  padding: 2.25rem 1rem;
  color: #64748b;
}

.cg-queue-empty svg {
  color: #334155;
  margin-bottom: 0.5rem;
}

/* Staged Inspection Summary Card */
.cg-staged-summary-card {
  background: #111a2e;
  border: 1px solid #1e3a8a;
  border-radius: 10px;
  padding: 1.25rem;
  margin-top: 1.25rem;
  display: none;
}

.cg-staged-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
  gap: 0.75rem;
  margin-top: 0.75rem;
}

.cg-staged-stat {
  background: #090f1d;
  border: 1px solid #1e293b;
  border-radius: 6px;
  padding: 0.6rem 0.75rem;
}

.cg-staged-stat-val {
  font-family: ui-monospace, monospace;
  font-size: 1.15rem;
  font-weight: 800;
  color: #38bdf8;
}

.cg-staged-stat-label {
  font-size: 0.68rem;
  color: #94a3b8;
  text-transform: uppercase;
  margin-top: 0.15rem;
}

/* Honest Technical Notice */
.cg-notice-box {
  background: rgba(15, 23, 42, 0.6);
  border: 1px solid #1e293b;
  border-left: 3px solid #38bdf8;
  border-radius: 8px;
  padding: 0.85rem 1rem;
  margin-top: 1.25rem;
  display: flex;
  gap: 0.75rem;
  align-items: flex-start;
  font-size: 0.79rem;
  color: #94a3b8;
  line-height: 1.5;
}

.cg-notice-box strong {
  color: #e2e8f0;
}

/* ==========================================================================
   Ripple Simulation Section (Why CodeGuard)
   ========================================================================== */
.cg-ripple-card {
  background: #0d1527;
  border: 1px solid #1e293b;
  border-radius: 14px;
  padding: 1.75rem;
}

.cg-ripple-controls {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  margin-bottom: 1.5rem;
  flex-wrap: wrap;
}

.cg-ripple-btn {
  background: #111827;
  border: 1px solid #1f2937;
  color: #94a3b8;
  padding: 0.45rem 0.95rem;
  font-family: ui-monospace, monospace;
  font-size: 0.78rem;
  font-weight: 600;
  border-radius: 7px;
  cursor: pointer;
  transition: all 0.2s ease;
}

.cg-ripple-btn:hover {
  background: #1e293b;
  color: #ffffff;
}

.cg-ripple-btn.active {
  background: rgba(59, 130, 246, 0.18);
