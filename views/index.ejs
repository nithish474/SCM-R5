    desc: "Maintains relational tables for commits, file changes, dependency links, test executions, and defect history. Provides an immutable Software Configuration Management audit trail."
  },
  report: {
    title: "Audit Report Engine (reports.ejs)",
    tag: "Release Verdict & Compliance",
    desc: "Compiles formal verification reports with IEEE 828 SCM configuration accounting, release confidence ratings, and printable summaries for peer review."
  }
};

function showArchInfo(key) {
  var item = archData[key];
  if (!item) return;

  ['core', 'git', 'ast', 'risk', 'pytest', 'db', 'report'].forEach(function(k) {
    var node = document.getElementById('archNode' + k.charAt(0).toUpperCase() + k.slice(1));
    if (node) {
      if (k === key) {
        node.style.borderColor = '#38bdf8';
        node.style.boxShadow = '0 0 16px rgba(56, 189, 248, 0.35)';
      } else {
        node.style.borderColor = '';
        node.style.boxShadow = '';
      }
    }
  });

  document.getElementById('archInfoTitle').textContent = 'Selected Subsystem: ' + item.title;
  document.getElementById('archInfoTag').textContent = item.tag;
  document.getElementById('archInfoDesc').textContent = item.desc;
}
</script>

