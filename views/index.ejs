     ========================================================================== -->
<script>
// -------------------------------------------------------------
// A. Staged File Upload & Selection Interface Logic
// -------------------------------------------------------------
var stagedFilesList = [];
var MAX_FILE_SIZE_BYTES = 10 * 1024 * 1024; // 10MB limit

var ALLOWED_EXTENSIONS = [
  '.py', '.js', '.ts', '.jsx', '.tsx', '.java', '.c', '.cpp', '.h', '.hpp',
  '.cs', '.go', '.rs', '.html', '.css', '.json', '.yaml', '.yml', '.sql',
  '.md', '.toml', '.xml', '.txt', '.ini', '.sh'
];

var dropzone = document.getElementById('cgDropzone');
var fileInput = document.getElementById('cgFileInput');

if (dropzone && fileInput) {
  // Drag & drop event bindings
  ['dragenter', 'dragover'].forEach(function(eventName) {
    dropzone.addEventListener(eventName, function(e) {
      e.preventDefault();
      e.stopPropagation();
      dropzone.classList.add('drag-active');
    }, false);
  });

  ['dragleave', 'drop'].forEach(function(eventName) {
    dropzone.addEventListener(eventName, function(e) {
      e.preventDefault();
      e.stopPropagation();
      dropzone.classList.remove('drag-active');
    }, false);
  });

  dropzone.addEventListener('drop', function(e) {
    var dt = e.dataTransfer;
    if (dt && dt.files && dt.files.length > 0) {
      handleFilesSelected(dt.files);
    }
  }, false);

  // Keyboard accessibility on dropzone
  dropzone.addEventListener('keydown', function(e) {
    if (e.key === 'Enter' || e.key === ' ') {
      e.preventDefault();
      fileInput.click();
    }
  });

  fileInput.addEventListener('change', function(e) {
    if (this.files && this.files.length > 0) {
      handleFilesSelected(this.files);
      this.value = ''; // Reset input to allow selecting the same file again if removed
    }
  });
}

function showFileAlert(type, message) {
  var alertEl = document.getElementById('cgFileAlert');
  var textEl = document.getElementById('cgAlertText');
  if (!alertEl || !textEl) return;

  alertEl.className = 'cg-alert cg-alert-' + type;
  textEl.textContent = message;
  alertEl.style.display = 'flex';

  // Auto hide after 6 seconds for success/info
  if (type === 'success' || type === 'info') {
    setTimeout(function() {
      if (alertEl.style.display === 'flex') {
        alertEl.style.display = 'none';
      }
    }, 6000);
  }
}

function hideFileAlert() {
  var alertEl = document.getElementById('cgFileAlert');
  if (alertEl) alertEl.style.display = 'none';
}

function getFileExtension(filename) {
  var idx = filename.lastIndexOf('.');
  return idx !== -1 ? filename.substring(idx).toLowerCase() : '';
}

function getFileTypeCategory(ext, filename) {
  var lowerName = filename.toLowerCase();
  if (lowerName.startsWith('test_') || lowerName.endsWith('_test.py') || lowerName.includes('.test.') || lowerName.includes('.spec.')) {
    return { name: 'Test Suite', badgeClass: 'cg-ext-test' };
  }
  if (ext === '.py') return { name: 'Python Module', badgeClass: 'cg-ext-py' };
  if (ext === '.ts' || ext === '.tsx') return { name: 'TypeScript', badgeClass: 'cg-ext-ts' };
  if (ext === '.js' || ext === '.jsx') return { name: 'JavaScript', badgeClass: 'cg-ext-js' };
  if (ext === '.json' || ext === '.yaml' || ext === '.yml' || ext === '.toml') return { name: 'Config / Data', badgeClass: 'cg-ext-json' };
  if (ext === '.sql') return { name: 'SQL Schema / Query', badgeClass: 'cg-ext-sql' };
  if (ext === '.java') return { name: 'Java Class', badgeClass: 'cg-ext-default' };
  if (ext === '.c' || ext === '.cpp' || ext === '.h' || ext === '.hpp') return { name: 'C / C++ Source', badgeClass: 'cg-ext-default' };
  if (ext === '.html' || ext === '.css') return { name: 'UI Markup/Style', badgeClass: 'cg-ext-default' };
  if (ext === '.md') return { name: 'Documentation', badgeClass: 'cg-ext-default' };
  return { name: 'Source / Text', badgeClass: 'cg-ext-default' };
}

function formatFileSize(bytes) {
  if (bytes === 0) return '0 B';
  if (bytes < 1024) return bytes + ' B';
  if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
  return (bytes / (1024 * 1024)).toFixed(2) + ' MB';
}

function handleFilesSelected(fileList) {
  hideFileAlert();
  var accepted = 0;
  var skippedDuplicates = 0;
  var skippedUnsupported = 0;
  var skippedEmpty = 0;
  var skippedLarge = 0;

  for (var i = 0; i < fileList.length; i++) {
    var f = fileList[i];
    var ext = getFileExtension(f.name);

    if (f.size === 0) {
      skippedEmpty++;
      continue;
    }

    if (f.size > MAX_FILE_SIZE_BYTES) {
      skippedLarge++;
      continue;
    }

    if (!ALLOWED_EXTENSIONS.includes(ext)) {
      skippedUnsupported++;
      continue;
    }

    // Check duplicate in staged queue
    var isDuplicate = stagedFilesList.some(function(item) {
      return item.name === f.name && item.size === f.size;
    });

    if (isDuplicate) {
      skippedDuplicates++;
      continue;
    }

    stagedFilesList.push({
      id: 'file_' + Date.now() + '_' + Math.random().toString(36).substr(2, 6),
      name: f.name,
      size: f.size,
      type: f.type || 'text/plain',
      ext: ext,
      lastModified: f.lastModified
    });
    accepted++;
  }

  renderStagedFiles();

  // Feedback messaging
  if (accepted > 0 && skippedUnsupported === 0 && skippedDuplicates === 0 && skippedEmpty === 0) {
    showFileAlert('success', 'Successfully staged ' + accepted + ' file' + (accepted > 1 ? 's' : '') + ' in the workspace queue.');
  } else if (accepted > 0) {
    var notes = ['Staged ' + accepted + ' file' + (accepted > 1 ? 's' : '') + '.'];
    if (skippedDuplicates > 0) notes.push(skippedDuplicates + ' duplicate(s) skipped.');
    if (skippedUnsupported > 0) notes.push(skippedUnsupported + ' unsupported binary/non-text file(s) skipped.');
    if (skippedEmpty > 0) notes.push(skippedEmpty + ' empty (0-byte) file(s) skipped.');
    if (skippedLarge > 0) notes.push(skippedLarge + ' file(s) over 10MB limit skipped.');
    showFileAlert('warning', notes.join(' '));
  } else {
    if (skippedUnsupported > 0) {
      showFileAlert('error', 'Unsupported file format(s). Please select source code or text files (.py, .ts, .js, .json, .sql, .yaml, etc.).');
    } else if (skippedDuplicates > 0) {
      showFileAlert('info', 'All selected files are already in the staged queue.');
    } else if (skippedEmpty > 0) {
      showFileAlert('error', 'Selected file(s) are empty (0 bytes).');
    }
  }
}

function removeStagedFile(fileId) {
  stagedFilesList = stagedFilesList.filter(function(item) {
    return item.id !== fileId;
  });
  renderStagedFiles();
  showFileAlert('info', 'File removed from staged queue.');
}

function clearAllStagedFiles() {
  stagedFilesList = [];
  renderStagedFiles();
  document.getElementById('cgStagedSummaryCard').style.display = 'none';
  showFileAlert('info', 'Staged files queue cleared.');
}

function renderStagedFiles() {
  var listEl = document.getElementById('cgFileList');
  var countBadge = document.getElementById('cgFileCountBadge');
  var totalSizeBadge = document.getElementById('cgTotalSizeBadge');
  var clearBtn = document.getElementById('cgClearAllBtn');
  var inspectBtn = document.getElementById('cgInspectStagedBtn');
  if (!listEl) return;

  // Clear container
  listEl.innerHTML = '';

  var totalCount = stagedFilesList.length;
  var totalBytes = stagedFilesList.reduce(function(acc, item) { return acc + item.size; }, 0);

  if (countBadge) {
    countBadge.textContent = totalCount + ' file' + (totalCount === 1 ? '' : 's');
  }

  if (totalSizeBadge) {
    if (totalCount > 0) {
      totalSizeBadge.style.display = 'inline-flex';
      totalSizeBadge.textContent = formatFileSize(totalBytes);
    } else {
      totalSizeBadge.style.display = 'none';
    }
  }

  if (clearBtn) clearBtn.disabled = totalCount === 0;
  if (inspectBtn) inspectBtn.disabled = totalCount === 0;

  if (totalCount === 0) {
    var emptyDiv = document.createElement('div');
    emptyDiv.className = 'cg-queue-empty';
    emptyDiv.id = 'cgQueueEmptyState';

    emptyDiv.innerHTML = '<svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">' +
      '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>' +
      '<polyline points="14 2 14 8 20 8"></polyline>' +
      '</svg>' +
      '<p style="font-size: 0.88rem; margin-top: 0.35rem; color: #94a3b8;">No files staged yet.</p>' +
      '<p style="font-size: 0.76rem; color: #64748b; margin-top: 0.15rem;">Drop Python, JavaScript, TypeScript, or configuration files above to inspect their structural footprint.</p>';
    listEl.appendChild(emptyDiv);
    return;
  }

  // Safely construct DOM elements for each file to prevent innerHTML injection
  stagedFilesList.forEach(function(item) {
    var row = document.createElement('div');
    row.className = 'cg-file-row';

    var infoDiv = document.createElement('div');
    infoDiv.className = 'cg-file-info';

    var extCat = getFileTypeCategory(item.ext, item.name);

    var extBadge = document.createElement('span');
    extBadge.className = 'cg-file-ext-icon ' + extCat.badgeClass;
    extBadge.textContent = item.ext.replace('.', '') || 'TXT';

    var metaBox = document.createElement('div');
    metaBox.className = 'cg-file-name-meta';

    var nameEl = document.createElement('div');
    nameEl.className = 'cg-file-name';
    nameEl.textContent = item.name; // SAFE textContent

    var metaEl = document.createElement('div');
    metaEl.className = 'cg-file-meta';

    var sizeSpan = document.createElement('span');
    sizeSpan.textContent = formatFileSize(item.size);

    var catSpan = document.createElement('span');
    catSpan.textContent = '• ' + extCat.name;

    metaEl.appendChild(sizeSpan);
    metaEl.appendChild(catSpan);

    metaBox.appendChild(nameEl);
    metaBox.appendChild(metaEl);

    infoDiv.appendChild(extBadge);
    infoDiv.appendChild(metaBox);

    var removeBtn = document.createElement('button');
    removeBtn.type = 'button';
    removeBtn.className = 'cg-file-btn-remove';
    removeBtn.setAttribute('aria-label', 'Remove ' + item.name);
    removeBtn.title = 'Remove file';
    removeBtn.innerHTML = '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>';
    removeBtn.onclick = function() {
      removeStagedFile(item.id);
    };

    row.appendChild(infoDiv);
    row.appendChild(removeBtn);

    listEl.appendChild(row);
  });
}

function inspectStagedQueue() {
  if (stagedFilesList.length === 0) return;

  var summaryCard = document.getElementById('cgStagedSummaryCard');
  if (!summaryCard) return;

  var totalFiles = stagedFilesList.length;
  var totalBytes = stagedFilesList.reduce(function(acc, item) { return acc + item.size; }, 0);
  var sourceCount = 0;
  var testCount = 0;
  var configCount = 0;

  stagedFilesList.forEach(function(item) {
    var cat = getFileTypeCategory(item.ext, item.name);
    if (cat.name === 'Test Suite') testCount++;
    else if (cat.name === 'Config / Data' || item.ext === '.json' || item.ext === '.yaml' || item.ext === '.yml') configCount++;
    else sourceCount++;
  });

  document.getElementById('statTotalFiles').textContent = totalFiles;
  document.getElementById('statTotalSize').textContent = formatFileSize(totalBytes);
  document.getElementById('statSourceCount').textContent = sourceCount;
  document.getElementById('statTestCount').textContent = testCount;
  document.getElementById('statConfigCount').textContent = configCount;

  summaryCard.style.display = 'block';
  summaryCard.scrollIntoView({ behavior: 'smooth', block: 'nearest' });

  showFileAlert('success', 'Staged files signature analysis complete. ' + totalFiles + ' files inspected and categorized.');
}

