        <div class="cg-engine-body">
          <!-- Commit Ingestion Node -->
          <div class="cg-graph-node">
            <div class="cg-node-top">
              <span class="cg-node-tag">SCM Ingestion</span>
              <span class="cg-node-badge">branch: master</span>
            </div>
            <div class="cg-node-title">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#60a5fa" stroke-width="2">
                <circle cx="12" cy="18" r="3"></circle>
                <circle cx="6" cy="6" r="3"></circle>
                <circle cx="18" cy="6" r="3"></circle>
                <path d="M18 9v2a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V9"></path>
                <line x1="12" y1="12" x2="12" y2="15"></line>
              </svg>
              <span>Commit <%= recent_commits && recent_commits[0] ? recent_commits[0].commit_hash.substring(0, 7) : 'c9be741' %></span>
            </div>
            <div class="cg-node-detail">
              "<%= recent_commits && recent_commits[0] ? recent_commits[0].message : 'Commit baseline verified.' %>"
            </div>
          </div>

          <div class="cg-connector">
            <div class="cg-connector-line"></div>
          </div>

          <!-- AST Change Detection Node -->
          <div class="cg-graph-node">
            <div class="cg-node-top">
              <span class="cg-node-tag">AST Delta Analyzer</span>
              <span class="cg-node-badge" style="color: #fbbf24;">Layer 1 &bull; ast.parse</span>
            </div>
            <div class="cg-node-title">File Modifications & Churn Detected</div>
            <div class="cg-node-detail">
              <%= recent_commits && recent_commits[0] ? recent_commits[0].changed_files_count : 1 %> modified files &bull; +<%= recent_commits && recent_commits[0] ? recent_commits[0].lines_added : 12 %> / -<%= recent_commits && recent_commits[0] ? recent_commits[0].lines_deleted : 3 %> lines &bull; Author: <%= recent_commits && recent_commits[0] ? recent_commits[0].author : 'Alex Developer' %>
            </div>
          </div>

          <!-- Fan-out to affected files -->
          <div class="cg-fanout-grid">
            <div class="cg-fanout-item">
              <div class="cg-fanout-name">database.py</div>
              <div class="cg-fanout-type">Direct Delta</div>
            </div>
            <div class="cg-fanout-item">
              <div class="cg-fanout-name">login.py</div>
              <div class="cg-fanout-type">Downstream</div>
            </div>
            <div class="cg-fanout-item">
              <div class="cg-fanout-name">payment.py</div>
              <div class="cg-fanout-type">Downstream</div>
            </div>
          </div>

          <div class="cg-connector">
            <div class="cg-connector-line"></div>
          </div>

          <!-- Risk Indicator Badge -->
          <div class="cg-risk-indicator <%= recent_commits && recent_commits[0] && recent_commits[0].risk_level === 'High' ? 'high' : '' %>">
            <div>
              <div style="font-size: 0.68rem; text-transform: uppercase; color: #94a3b8; font-weight: 700;">Calculated Change Risk</div>
              <div class="cg-risk-val">
                <%= recent_commits && recent_commits[0] ? recent_commits[0].risk_level.toUpperCase() : 'MEDIUM' %> RISK (<%= recent_commits && recent_commits[0] ? recent_commits[0].risk_score : '8.8' %> pts)
              </div>
            </div>
            <div style="display: flex; gap: 0.35rem;">
              <span class="cg-badge cg-badge-blue" style="font-size: 0.65rem;">Fan-out: <%= recent_commits && recent_commits[0] ? recent_commits[0].affected_files_count : 4 %></span>
              <span class="cg-badge cg-badge-amber" style="font-size: 0.65rem;">Defects: 1</span>
            </div>
          </div>

          <!-- Targeted RTS Node -->
          <div class="cg-graph-node" style="border-color: #059669; background: rgba(6, 78, 59, 0.2);">
            <div class="cg-node-top">
              <span class="cg-node-tag" style="color: #34d399;">Targeted Regression Selection</span>
              <span class="cg-node-badge" style="color: #6ee7b7; border-color: #059669;">RTS Minimizer</span>
            </div>
            <div class="cg-node-title" style="color: #a7f3d0;">
              Executed <%= recent_commits && recent_commits[0] ? recent_commits[0].passed_tests : 2 %> of <%= recent_commits && recent_commits[0] ? recent_commits[0].total_tests : 2 %> Impacted Tests (100% Pass)
            </div>
            <div class="cg-node-detail" style="color: #6ee7b7;">
              Skipped unrelated test suites &bull; Execution time: 0.08s (94% CI speedup)
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

