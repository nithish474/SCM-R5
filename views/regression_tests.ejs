<%- include('partials/header', { title: 'CodeGuard - Regression Test Selection (RTS)', activePage: 'regression-tests' }) %>

<div class="page-header d-flex justify-between align-center">
    <div>
        <div class="breadcrumb">
            <a href="/">Home</a> &gt; <span>Regression Testing</span>
        </div>
        <h1 class="page-title">Regression Test Selection (RTS) Engine</h1>
        <p class="text-muted" style="margin-top: 0.25rem;">
            Targeted test minimization: mapping modified source components to relevant PyTest suites to avoid full-suite testing bottlenecks.
        </p>
    </div>
    <div class="d-flex gap-sm">
        <a href="/dashboard" class="btn btn-secondary btn-sm">View Dashboard</a>
        <button class="btn btn-primary btn-sm" onclick="quickAnalyzeLatest()">Execute Latest RTS</button>
    </div>
</div>

<!-- RTS Concept & Efficiency Metrics Bar -->
<div class="metrics-grid" style="margin-bottom: 1.5rem;">
    <div class="metric-card">
        <div class="d-flex justify-between align-center" style="margin-bottom: 0.35rem;">
            <div class="metric-label" style="margin-bottom: 0;">Total Tests Executed</div>
            <% if (metrics.failed_tests > 0) { %>
                <span class="badge badge-failed" style="font-size: 0.65rem; padding: 0.15rem 0.45rem;">Regression Detected</span>
            <% } else { %>
                <span class="badge badge-passed" style="font-size: 0.65rem; padding: 0.15rem 0.45rem;">Stable</span>
            <% } %>
        </div>
        <div class="metric-value"><%= metrics.total_tests %></div>
        <div class="metric-subtext text-muted">Across <%= metrics.total_commits %> analyzed baselines</div>
    </div>
    <div class="metric-card">
        <div class="d-flex justify-between align-center" style="margin-bottom: 0.35rem;">
            <div class="metric-label" style="margin-bottom: 0;">Passed Assertions</div>
            <span class="badge badge-passed" style="font-size: 0.65rem; padding: 0.15rem 0.45rem;">Stable</span>
        </div>
        <div class="metric-value text-success"><%= metrics.passed_tests %></div>
        <div class="metric-subtext text-success font-medium"><%= metrics.pass_rate %>% Overall Pass Rate</div>
    </div>
    <div class="metric-card">
        <div class="d-flex justify-between align-center" style="margin-bottom: 0.35rem;">
            <div class="metric-label" style="margin-bottom: 0;">Detected Failures</div>
            <% if (metrics.failed_tests > 0) { %>
                <span class="badge badge-failed" style="font-size: 0.65rem; padding: 0.15rem 0.45rem;">Regression Detected</span>
            <% } else { %>
                <span class="badge badge-passed" style="font-size: 0.65rem; padding: 0.15rem 0.45rem;">Stable</span>
            <% } %>
        </div>
        <div class="metric-value <%= metrics.failed_tests > 0 ? 'text-danger' : 'text-muted' %>"><%= metrics.failed_tests %></div>
        <div class="metric-subtext <%= metrics.failed_tests > 0 ? 'text-danger' : 'text-muted' %>">Regressions prevented</div>
    </div>
    <div class="metric-card">
        <div class="d-flex justify-between align-center" style="margin-bottom: 0.35rem;">
            <div class="metric-label" style="margin-bottom: 0;">Test Minimization Ratio</div>
            <span class="badge badge-passed" style="font-size: 0.65rem; padding: 0.15rem 0.45rem;">Stable</span>
        </div>
        <div class="metric-value text-primary">~72%</div>
        <div class="metric-subtext text-primary font-medium">Compute time saved vs full suite</div>
    </div>
</div>

<!-- Architecture & Pipeline Banner -->
<div class="card shadow-xs" style="margin-bottom: 1.5rem; padding: 1.25rem 1.5rem;">
    <h3 style="font-size: 1.05rem; margin-bottom: 0.5rem;">The CodeGuard RTS Methodology</h3>
    <p class="text-muted" style="font-size: 0.88rem; margin-bottom: 1rem;">
        Traditional continuous integration runs every unit, integration, and end-to-end test on every push. CodeGuard uses static AST dependency propagation to isolate only the blast radius of changes.
    </p>

    <div class="rts-flow-steps">
        <div class="rts-flow-box">
            <span class="rts-step-num">Step 1</span>
            <strong>Changed Code</strong>
            <span class="text-muted">Git delta extraction</span>
        </div>
        <div class="rts-flow-arrow">&rarr;</div>
        <div class="rts-flow-box">
            <span class="rts-step-num">Step 2</span>
            <strong>Affected Components</strong>
            <span class="text-muted">AST downstream mapping</span>
        </div>
        <div class="rts-flow-arrow">&rarr;</div>
        <div class="rts-flow-box highlighted">
            <span class="rts-step-num">Step 3</span>
            <strong>Relevant Tests (RTS)</strong>
            <span class="text-primary font-semibold">Targeted selection</span>
        </div>
        <div class="rts-flow-arrow">&rarr;</div>
        <div class="rts-flow-box">
            <span class="rts-step-num">Step 4</span>
            <strong>Automated Execution</strong>
            <span class="text-muted">PyTest runner</span>
        </div>
        <div class="rts-flow-arrow">&rarr;</div>
        <div class="rts-flow-box">
            <span class="rts-step-num">Step 5</span>
            <strong>Release Verdict</strong>
            <span class="text-success font-semibold">Safe / Attention</span>
        </div>
    </div>
</div>

<!-- Commit Regression Runs Table -->
<div class="card shadow-xs">
    <div class="card-header d-flex justify-between align-center flex-wrap gap-sm">
        <div>
            <h2 class="card-title">Recent Commit Regression Test Runs</h2>
            <p class="card-subtitle">Per-baseline execution status, selected suites, and verification outcomes.</p>
        </div>
        <div class="d-flex align-center gap-sm flex-wrap">
            <div class="d-flex align-center gap-xs">
                <button class="btn btn-sm btn-outline rts-status-btn active" data-status="all" onclick="filterByRtsStatus('all', this)">All</button>
                <button class="btn btn-sm btn-outline rts-status-btn" data-status="passed" onclick="filterByRtsStatus('passed', this)">Passed</button>
                <button class="btn btn-sm btn-outline rts-status-btn" data-status="failed" onclick="filterByRtsStatus('failed', this)">Failed</button>
            </div>
            <div class="search-box">
                <input type="text" id="rtsSearchInput" class="form-input form-input-sm" placeholder="Filter by commit or author..." oninput="applyRtsFilters()">
            </div>
        </div>
    </div>

    <div class="table-responsive">
        <table class="data-table" id="rtsTable">
            <thead>
                <tr>
                    <th>Commit Baseline</th>
                    <th>Message</th>
                    <th>Author</th>
                    <th>Risk Score</th>
                    <th>Selected Tests</th>
                    <th>Verdict</th>
                    <th>Pass Rate</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <% commits.forEach(function(c) { %>
                <tr class="rts-row" data-status="<%= c.failed_tests > 0 ? 'failed' : (c.total_tests > 0 ? 'passed' : 'none') %>">
                    <td>
                        <a href="/commit/<%= c.commit_hash %>" class="commit-hash">
                            <code><%= c.commit_hash.substring(0, 7) %></code>
                        </a>
                    </td>
                    <td class="commit-msg">
                        <span class="font-medium"><%= c.message %></span>
                    </td>
                    <td><%= c.author %></td>
                    <td>
                        <span class="badge badge-<%= c.risk_level.toLowerCase() %>">
                            <%= c.risk_level %> (<%= c.risk_score %> pts)
                        </span>
                    </td>
                    <td>
                        <span class="font-semibold"><%= c.total_tests %> Selected</span>
                    </td>
                    <td>
                        <% if (c.failed_tests > 0) { %>
                            <span class="badge badge-high" style="font-size: 0.75rem;">
                                <%= c.failed_tests %> Failed
                            </span>
                        <% } else if (c.total_tests === 0) { %>
                            <span class="badge badge-secondary" style="font-size: 0.75rem;">None</span>
                        <% } else { %>
                            <span class="badge badge-low" style="font-size: 0.75rem;">
                                All <%= c.passed_tests %> Passed
                            </span>
                        <% } %>
                    </td>
                    <td>
                        <% const rate = c.total_tests > 0 ? Math.round((c.passed_tests / c.total_tests) * 100) : 100; %>
                        <div class="d-flex align-center gap-xs">
                            <div class="progress-bar-wrap" style="width: 60px; height: 6px; background: #e2e8f0; border-radius: 3px; overflow: hidden;">
                                <div style="width: <%= rate %>%; height: 100%; background: <%= rate === 100 ? '#10b981' : '#ef4444' %>;"></div>
                            </div>
                            <span style="font-size: 0.75rem; font-weight: 600;"><%= rate %>%</span>
                        </div>
                    </td>
                    <td>
                        <div class="d-flex gap-xs">
                            <a href="/commit/<%= c.commit_hash %>#test-results" class="btn btn-sm btn-outline" title="Inspect Test Output">Test Logs</a>
                            <a href="/report/<%= c.commit_hash %>" class="btn btn-sm btn-secondary" title="View Quality Report">Report</a>
                        </div>
                    </td>
                </tr>
                <% }); %>
                <tr id="rtsEmptyFiltered" style="display: none;">
                    <td colspan="8" class="text-center text-muted" style="padding: 2.5rem;">
                        No regression test records match the specified filters.
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<script>
let currentRtsStatus = 'all';

function filterByRtsStatus(status, btnEl) {
    document.querySelectorAll('.rts-status-btn').forEach(b => b.classList.remove('active'));
    if (btnEl) btnEl.classList.add('active');
    currentRtsStatus = status;
    applyRtsFilters();
}

function applyRtsFilters() {
    const q = (document.getElementById('rtsSearchInput')?.value || '').toLowerCase().trim();
    const rows = document.querySelectorAll('.rts-row');
    let visible = 0;

    rows.forEach(row => {
        const text = row.textContent.toLowerCase();
        const rowStatus = (row.dataset.status || '').toLowerCase();

        const matchesQuery = !q || text.includes(q);
        const matchesStatus = currentRtsStatus === 'all' || rowStatus === currentRtsStatus;

        if (matchesQuery && matchesStatus) {
            row.style.display = '';
            visible++;
        } else {
            row.style.display = 'none';
        }
    });

    const emptyRow = document.getElementById('rtsEmptyFiltered');
    if (emptyRow) {
        emptyRow.style.display = (visible === 0 && rows.length > 0) ? '' : 'none';
    }
}
</script>

<%- include('partials/footer') %>
